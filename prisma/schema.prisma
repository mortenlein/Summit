generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tournament {
  id                 String            @id @default(uuid())
  name               String
  game               String            @default("CS2")
  category           String            @default("BRACKET")
  type               String
  format             String            @default("SINGLE_ELIMINATION")
  teamSize           Int               @default(5)
  // Best-of escalation, counted from the Grand Final backward (stage-relative, so it works for
  // any bracket size): N = the last N rounds use this best-of. 0/null = off (BO1).
  // 1 = Grand Final only, 2 = Semi-Finals onward, 3 = Quarter-Finals onward, 4 = Round-of-16 onward.
  bo3LastRounds      Int?
  bo5LastRounds      Int?
  hasThirdPlace      Boolean           @default(false)
  steamSignupEnabled Boolean           @default(false)
  eonBridgeToken     String?           @unique
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @default(now()) @updatedAt
  rosterLocked       Boolean           @default(false)
  /// Organizer kill switch: stop all Discord DMs for this tournament without stopping
  /// channel posts. Reachable from a phone when something is going wrong on the floor.
  discordDmPaused    Boolean           @default(false)
  auditLogs          AuditLog[]
  matches            Match[]
  notifications      NotificationLog[]
  players            Player[]
  scoreboard         ScoreboardEntry[]
  teams              Team[]
}

model Team {
  id           String            @id @default(uuid())
  name         String
  logoUrl      String?
  seed         Int?
  tournamentId String
  inviteCode   String?           @unique
  updatedAt    DateTime          @default(now()) @updatedAt
  matchHome    Match[]           @relation("HomeTeam")
  matchAway    Match[]           @relation("AwayTeam")
  players      Player[]
  scoreboard   ScoreboardEntry[]
  tournament   Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

model Player {
  id          String  @id @default(uuid())
  name        String
  nickname    String?
  countryCode String?
  seating     String?
  steamId     String?
  isOnline    Boolean @default(false)
  isLeader    Boolean @default(false)
  /// Set when floor staff confirm the player is physically at their seat (marshal board).
  checkedInAt DateTime?
  teamId      String
  tournamentId String
  userId      String?
  updatedAt   DateTime @default(now()) @updatedAt
  team        Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tournament  Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user        User?   @relation(fields: [userId], references: [id])

  @@unique([tournamentId, userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  steamId       String?   @unique
  // UI language. Needed server-side (not just as a cookie) so a push notification can be
  // written in the recipient's own language — see src/lib/notify.ts.
  locale        String?
  discordLink       DiscordLink?
  discordLinkCode   DiscordLinkCode?
  discordDmAttempts DiscordDmAttempt[]
  accounts      Account[]
  sessions      Session[]
  players       Player[]
  pushSubscriptions PushSubscription[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Match {
  id               String     @id @default(uuid())
  tournamentId     String
  homeTeamId       String?
  awayTeamId       String?
  homeScore        Int        @default(0)
  awayScore        Int        @default(0)
  mapScores        String     @default("[]")
  bestOf           Int        @default(1)
  scoreLimit       Int        @default(1)
  winnerId         String?
  // How the match was decided when it was not simply played out: 'FORFEIT' (a team no-showed or
  // withdrew) or 'WALKOVER'. Null for a normally played match.
  resultType       String?
  bracketType      String     @default("WINNERS")
  round            Int
  matchOrder       Int
  nextMatchId      String?
  loserNextMatchId String?
  nextMatchSlot      String?
  loserNextMatchSlot String?
  serverIp         String?
  serverPort       String?
  serverPassword   String?
  status           String     @default("PENDING")
  updatedAt        DateTime   @default(now()) @updatedAt
  tournament       Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  homeTeam         Team?      @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam         Team?      @relation("AwayTeam", fields: [awayTeamId], references: [id])
}

model ScoreboardEntry {
  id           String     @id @default(uuid())
  tournamentId String
  teamId       String
  kills        Int        @default(0)
  placement    Int        @default(0)
  points       Int        @default(0)
  updatedAt    DateTime   @updatedAt
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, teamId])
}

model NotificationLog {
  id          String   @id @default(cuid())
  type        String
  title       String
  description String?
  tournamentId String?
  createdAt   DateTime @default(now())
  tournament  Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String      @id @default(cuid())
  tournamentId String?
  entityType  String
  entityId    String
  action      String
  summary     String
  actor       String?
  metadata    String?
  createdAt   DateTime    @default(now())
  tournament  Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

/// A player's Discord account, bound to their Summit (Steam) account by redeeming a code.
/// Steam is the identity Summit trusts; this is purely an address to deliver to.
model DiscordLink {
  userId          String    @id
  discordId       String    @unique
  discordUsername String
  /// Cached DM channel id. Latency only — never trusted. A 404/10003 clears it and the next
  /// send re-opens the channel.
  dmChannelId     String?
  /// UNKNOWN | SENT | BLOCKED. Rewritten by EVERY send, not just at link time, because a kid
  /// can close their DMs at any point. SENT means Discord accepted it — never that it was read.
  dmState         String    @default("UNKNOWN")
  dmCheckedAt     DateTime?
  dmError         String?
  /// Honoured at fan-out, before any send is attempted.
  optOut          Boolean   @default(false)
  linkedAt        DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A short-lived code shown in the app and redeemed with /koble in the Discord server.
/// One live code per user — the @unique on userId gives that for free.
model DiscordLinkCode {
  code      String   @id
  userId    String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One row per recipient per send attempt. This is what stops the UI claiming a player was
/// notified when Discord refused: nothing may render "varslet" that is not backed by a row here.
model DiscordDmAttempt {
  id          String   @id @default(cuid())
  userId      String
  discordId   String
  /// LINK_PROBE | MATCH_CALLED | MATCH_LIVE | MATCH_UPCOMING | MATCH_RESULT
  event       String
  matchId     String?
  /// SENT | BLOCKED | UNKNOWN_USER | RATE_LIMITED | ERROR | SKIPPED_OPTOUT | SIMULATED
  /// SENT is written ONLY when Discord itself accepted the message. A deployment that cannot
  /// talk to Discord (mock mode, or no bot token) writes SIMULATED instead — see
  /// `recordDmAttempt` in src/lib/discord-reach.ts, which is the only supported writer.
  outcome     String
  /// Discord's own JSON error code, e.g. 50007 "Cannot send messages to this user".
  discordCode Int?
  locale      String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, event, userId])
  @@index([matchId])
  @@index([createdAt])
}
