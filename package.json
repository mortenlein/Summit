{
  "name": "summit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/migrate.js && next dev -p 4001",
    "dev:e2e": "node scripts/dev-e2e.js",
    "db:prepare": "node scripts/migrate.js",
    "migrate": "node scripts/migrate.js",
    "build": "node scripts/migrate.js && npx prisma generate && node scripts/clean-next.js && next build",
    "start": "next start",
    "lint": "next lint",
    "test:e2e": "playwright test",
    "test:bracket": "ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/test-bracket-utils.ts",
    "test:cs2-webhook": "node scripts/test-cs2-webhook.js",
    "postinstall": "prisma generate",
    "i18n:check": "node scripts/check-i18n.js"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.3",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.102.8",
    "bufferutil": "^4.1.0",
    "discord-api-types": "^0.38.55",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "erlpack": "^0.1.4",
    "lucide-react": "^0.477.0",
    "next": "^15.5.25",
    "next-auth": "^4.24.15",
    "next-auth-steam": "^0.4.0",
    "next-intl": "^4.14.4",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reactflow": "^11.11.4",
    "sharp": "^0.35.4",
    "utf-8-validate": "^6.0.6",
    "uuid": "^14.0.2",
    "web-push": "^3.6.7",
    "zlib-sync": "^0.1.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.5.6",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.25",
    "postcss": "^8.5.28",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "ts-patch": "^3.3.0",
    "typescript": "^5",
    "typescript-transform-paths": "^3.5.6"
  }
}
