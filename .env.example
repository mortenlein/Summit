# Template only — copy to .env (git-ignored, chmod 600) and fill with REAL values.
# Never put real deployment values in this file.
#
# Every variable the app reads is listed here. Production (`docker-compose.prod.yml`) sets
# NODE_ENV, DATABASE_URL and NEXTAUTH_URL itself, so those three can stay as-is in .env.
#
# Everything above the `summit-bot` block at the bottom belongs to the APP container (`summit`)
# and goes in `.env`. That last block belongs to the gateway-bot container (`summit-bot`) and
# goes in a separate `.env.bot`. Each line there names its container.

# === Required ===================================================================================

# Public origin the app runs on. Drives the Steam realm/return_to URL and the links in
# Discord/push notifications. Prod compose overrides this with https://turnering.mortenlab.xyz.
NEXTAUTH_URL=http://192.168.3.20:4001

# Long random string that signs session cookies. Rotating it logs everyone out.
#   openssl rand -hex 32
NEXTAUTH_SECRET=change-me

# Comma-separated steamid64 allowlist that resolves to admin/organizer at login.
# Find your steamid64 at https://steamid.io. Admin is an identity, not a password.
# (The legacy singular spelling ADMIN_STEAMID is still honoured as a fallback — prefer this one.)
ADMIN_STEAMIDS=76561198000000001

# Steam Web API key — https://steamcommunity.com/dev/apikey
# Without it EVERY /api/auth/* request fails, so nobody can sign in at all.
STEAM_API_KEY=

# SQLite path. Docker sets this automatically to the mounted volume (file:/app/data/prod.db).
DATABASE_URL=file:./dev.db

# === Operational ================================================================================

# Comma-separated steamid64 allowlist for floor staff (marshals). Marshals reach /marshal and run
# match flow (call, check-in, score) but are not full organizers.
MARSHAL_STEAMIDS=

# Bearer key inbound CS2 / GSI score updates must send to /api/webhooks/cs2. The webhook fails
# closed (HTTP 503) if unset, so set this before pointing a live source at it.
# NOTE: the EON bridge does NOT use this — it uses a per-tournament token minted in Control.
CS2_WEBHOOK_KEY=

# Optional: forward every accepted /api/webhooks/cs2 payload to a second consumer (e.g. an
# overlay or analytics service). MIRROR_KEY, if set, is sent as its bearer token. Failures are
# logged and ignored.
# CS2_WEBHOOK_MIRROR_URL=
# CS2_WEBHOOK_MIRROR_KEY=

# Web push (player "your match is up" alerts). Generate a keypair with:
#   npx web-push generate-vapid-keys
# Leave blank to disable web push (the Enable-alerts button hides itself). Push requires HTTPS.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@summit.local

# Discord announcements (match called / results / signups / "bracket is live"). Set EITHER a
# channel webhook URL, OR a bot token + channel id. If neither is set — or
# NEXT_PUBLIC_STRATEGY_3_MOCK=true — announcements are only written to the in-app notification log.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
# DISCORD_BOT_TOKEN=
# DISCORD_CHANNEL_ID=

# Language the Discord channel is posted in: nb (default) or en. A channel is read by the whole
# room at once, so there is no per-player language here the way there is for push — this is one
# deployment-wide choice. The in-app notification log stays English either way: it is a staff
# record (and the duplicate-announcement key), not player-facing copy.
# DISCORD_LOCALE=nb

# The Discord application id. The gateway bot registers its guild commands with it, so it is
# NOT optional once the bot is deployed — see the summit-bot section at the bottom of this file
# for the copy the bot itself reads. (It used to be described here as "optional Discord OAuth
# sign-in"; only Steam grants roles, and there is no Discord sign-in.)
# DISCORD_CLIENT_ID=

# The guild (server) the bot's /koble and /stopp are registered in. Guild-scoped commands
# propagate instantly; global ones take up to an hour. Also gates the in-app link card.
# DISCORD_GUILD_ID=

# Port the server listens on. Defaults to 4001 (and the Docker image pins it), so only set this
# if you need a different one locally.
# PORT=4001

# === Local dev only =============================================================================

# Enable mock persona login buttons on /login (server side):
# MOCK_AUTH_MODE=true
# Show the mock persona buttons in the browser:
# NEXT_PUBLIC_MOCK_AUTH=true
# Intercept Discord delivery — announcements go to the in-app log only:
# NEXT_PUBLIC_STRATEGY_3_MOCK=true
# Verbose next-auth logging (noisy; useful when Steam sign-in misbehaves):
# NEXTAUTH_DEBUG=true
# Append one JSON line per web-push delivery attempt to this file. A push is encrypted with the
# subscriber's keys, so this is the only way to see what was actually sent (and in which
# language). The e2e suite sets it; leave it unset in production.
# PUSH_DELIVERY_LOG=/tmp/summit-push.log

# scripts/backup.sh takes its overrides from the shell, not from .env:
#   BACKUP_DIR, BACKUP_KEEP_DAYS (default 30), SUMMIT_CONTAINER, SUMMIT_UPLOADS_DIR,
#   SUMMIT_DB_IN_CONTAINER

# === Container `summit-bot` - file `.env.bot`, NOT this file ====================================
#
# The gateway bot is a second container (`docker-compose.prod.yml` service `summit-bot`) and it
# reads its own file, `/home/mole/apps/Summit/.env.bot` (chmod 600; the `.env*` rule already
# keeps it out of version control). It deliberately does NOT get `env_file: .env` - an always-on
# process holding an outbound socket to Discord has no business with NEXTAUTH_SECRET or
# STEAM_API_KEY.
#
# Copy the block below into `.env.bot` and fill it in. Uncomment nothing here: these lines are
# documentation, and the app container ignores them.
#
#   DISCORD_BOT_TOKEN=      # summit-bot: gateway login. The SAME token as the app's
#                           #   DISCORD_BOT_TOKEN above - the app sends, the bot listens, one
#                           #   Discord application. A gateway bot cannot avoid sharing it.
#   DISCORD_CLIENT_ID=      # summit-bot: application id, for guild command registration.
#   DISCORD_GUILD_ID=       # summit-bot: the guild to register /koble and /stopp in.
#   SUMMIT_BOT_KEY=         # BOTH containers: the bearer the bot presents to
#                           #   POST /api/discord/link and /api/discord/optout, and that the app
#                           #   checks. `openssl rand -hex 32`. The SAME value must be in `.env`
#                           #   (app) and `.env.bot` (bot). Do not reuse CS2_WEBHOOK_KEY. The app
#                           #   fails closed (503) while it is unset.
#   SUMMIT_API_URL=http://summit:4001
#                           # summit-bot: how the bot reaches the app. The compose service name,
#                           #   never the tunnel - https://turnering.mortenlab.xyz would leave the
#                           #   box and come back in. `SUMMIT_URL` is accepted as an alias.
#   TZ=Europe/Oslo          # summit-bot: set by the image and by compose; override only to test.
#
# Optional, all with working defaults - you will not normally set any of them:
#
#   BOT_HEALTH_PORT=4002    # summit-bot: port for /healthz and /status. Nothing publishes it.
#   BOT_HEALTH_HOST=0.0.0.0 # summit-bot: bind address INSIDE the container. Leave it. A
#                           #   loopback-only listener passes the HEALTHCHECK while every other
#                           #   reader fails, which is the exact 01:00 confusion to avoid.
#   SUMMIT_TIMEOUT_MS=8000  # summit-bot: how long to wait for the app before showing the player
#                           #   the "Summit isn't responding" fallback.
#   BOT_FATAL_EXIT_DELAY_MS=30000
#                           # summit-bot: how long to stay up after an unrecoverable error (bad
#                           #   token, missing variable) before exiting. Discord's IDENTIFY limit
#                           #   is 1000/day per token; a fast crash loop under
#                           #   `restart: unless-stopped` burns it in ~35 minutes and 429s the
#                           #   token for the rest of the day. Lower it only in tests.
#   BOT_NO_GATEWAY=true     # summit-bot: TEST ONLY. Boot, serve health, never open a Discord
#                           #   socket. Used by bot/test/smoke.test.js so the container is
#                           #   verifiable with no real token. Never set this in production.
