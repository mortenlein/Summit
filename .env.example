# Template only — copy to .env (git-ignored, chmod 600) and fill with REAL values.
# Never put real deployment values in this file.
#
# Every variable the app reads is listed here. Production (`docker-compose.prod.yml`) sets
# NODE_ENV, DATABASE_URL and NEXTAUTH_URL itself, so those three can stay as-is in .env.

# === Required ===================================================================================

# Public origin the app runs on. Drives the Steam realm/return_to URL and the links in
# Discord/push notifications. Prod compose overrides this with https://turnering.mortenlab.xyz.
NEXTAUTH_URL=http://192.168.3.20:4001

# Long random string that signs session cookies. Rotating it logs everyone out.
#   openssl rand -hex 32
NEXTAUTH_SECRET=change-me

# Comma-separated steamid64 allowlist that resolves to admin/organizer at login.
# Find your steamid64 at https://steamid.io. Admin is an identity, not a password.
# (The legacy singular spelling ADMIN_STEAMID is still honoured as a fallback — prefer this one.)
ADMIN_STEAMIDS=76561198000000001

# Steam Web API key — https://steamcommunity.com/dev/apikey
# Without it EVERY /api/auth/* request fails, so nobody can sign in at all.
STEAM_API_KEY=

# SQLite path. Docker sets this automatically to the mounted volume (file:/app/data/prod.db).
DATABASE_URL=file:./dev.db

# === Operational ================================================================================

# Comma-separated steamid64 allowlist for floor staff (marshals). Marshals reach /marshal and run
# match flow (call, check-in, score) but are not full organizers.
MARSHAL_STEAMIDS=

# Bearer key inbound CS2 / GSI score updates must send to /api/webhooks/cs2. The webhook fails
# closed (HTTP 503) if unset, so set this before pointing a live source at it.
# NOTE: the EON bridge does NOT use this — it uses a per-tournament token minted in Control.
CS2_WEBHOOK_KEY=

# Optional: forward every accepted /api/webhooks/cs2 payload to a second consumer (e.g. an
# overlay or analytics service). MIRROR_KEY, if set, is sent as its bearer token. Failures are
# logged and ignored.
# CS2_WEBHOOK_MIRROR_URL=
# CS2_WEBHOOK_MIRROR_KEY=

# Web push (player "your match is up" alerts). Generate a keypair with:
#   npx web-push generate-vapid-keys
# Leave blank to disable web push (the Enable-alerts button hides itself). Push requires HTTPS.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@summit.local

# Discord announcements (match called / results / signups / "bracket is live"). Set EITHER a
# channel webhook URL, OR a bot token + channel id. If neither is set — or
# NEXT_PUBLIC_STRATEGY_3_MOCK=true — announcements are only written to the in-app notification log.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
# DISCORD_BOT_TOKEN=
# DISCORD_CHANNEL_ID=

# Language the Discord channel is posted in: nb (default) or en. A channel is read by the whole
# room at once, so there is no per-player language here the way there is for push — this is one
# deployment-wide choice. The in-app notification log stays English either way: it is a staff
# record (and the duplicate-announcement key), not player-facing copy.
# DISCORD_LOCALE=nb

# Discord DMs to players (called / live). The bot token above is what sends them — the app owns
# the send path, the gateway bot only handles /koble. Ships OFF: flip to true after a rehearsal
# with real kids and real phones, never straight into a LAN.
# DISCORD_DM_ENABLED=false
# One JSON line per DM attempt (who, which match, which language, what Discord answered). At
# 02:00 "did the DM go out" has to be answerable from a file. Mirrors PUSH_DELIVERY_LOG.
# DISCORD_DM_LOG=/app/data/discord-dm.log
# Milliseconds between DMs, process-wide (default 1000, ±250 ms jitter). Opening DM channels in
# a burst is an anti-spam flag vector; this is the knob to raise at 01:00 if Discord complains.
# DISCORD_DM_INTERVAL_MS=1000

# Optional Discord OAuth sign-in (a second next-auth provider alongside Steam). Only Steam grants
# roles, so this is cosmetic unless you need it; leave unset to keep Steam-only sign-in.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# The guild the bot's commands are registered in. Also one of the three keys that gate account
# linking: with any of them unset the /koble card self-hides and the bot callbacks answer 503,
# so this deploys safely before the bot container exists.
# DISCORD_GUILD_ID=

# === Discord account linking (/koble) ===========================================================

# Shown as step 1 of the link card. A player who has Discord but was never added to the club's
# server cannot run /koble at all — the command does not exist for a non-member — so this is
# required, not decorative.
# DISCORD_INVITE_URL=https://discord.gg/xxxxxxx

# The bearer the gateway bot presents on POST /api/discord/link and /api/discord/optout.
# `openssl rand -hex 32`. Must NOT be the same value as CS2_WEBHOOK_KEY (that one is handed to a
# game server). Unset = those two routes are 503: an absent secret never means "no check".
# SUMMIT_BOT_KEY=

# Port the server listens on. Defaults to 4001 (and the Docker image pins it), so only set this
# if you need a different one locally.
# PORT=4001

# === Local dev only =============================================================================

# Enable mock persona login buttons on /login (server side):
# MOCK_AUTH_MODE=true
# Show the mock persona buttons in the browser:
# NEXT_PUBLIC_MOCK_AUTH=true
# Intercept Discord delivery — announcements go to the in-app log only:
# NEXT_PUBLIC_STRATEGY_3_MOCK=true
# Verbose next-auth logging (noisy; useful when Steam sign-in misbehaves):
# NEXTAUTH_DEBUG=true
# Append one JSON line per web-push delivery attempt to this file. A push is encrypted with the
# subscriber's keys, so this is the only way to see what was actually sent (and in which
# language). The e2e suite sets it; leave it unset in production.
# PUSH_DELIVERY_LOG=/tmp/summit-push.log
# Comma-separated Discord ids the *mock* DM probe refuses with error 50007 ("cannot send messages
# to this user"), so the blocked-DM path can be exercised without a real token. The e2e suite sets
# it; it has no effect once a real sender is wired in. Leave unset in production.
# DISCORD_DM_MOCK_BLOCKED=

# scripts/backup.sh takes its overrides from the shell, not from .env:
#   BACKUP_DIR, BACKUP_KEEP_DAYS (default 30), SUMMIT_CONTAINER, SUMMIT_UPLOADS_DIR,
#   SUMMIT_DB_IN_CONTAINER
